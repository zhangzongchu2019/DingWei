   "note": "UTF-16 code unit 排序:U+1F600(代理对 d83d de00)排在 U+FFFD 之前(与 code point 序相反);z<e-acute",
   "input": {
    "�": 1,
    "😀": 2,
    "z": 3,
    "é": 4
   },
   "expected_canonical": "{\"z\":3,\"é\":4,\"😀\":2,\"�\":1}",
   "expected_sha256": "847cb8df5ebc5e55b4e7aed37df74cc4a1e9742e82ec03ee174f0c14dd9fe800"
  },
  {
   "id": "V03-num-int",
   "kind": "canonical",
   "note": "整数与安全上界",
   "input": {
    "n0": 0,
    "n1": -1,
    "n2": 42,
    "n3": 9007199254740991
   },
   "expected_canonical": "{\"n0\":0,\"n1\":-1,\"n2\":42,\"n3\":9007199254740991}",
   "expected_sha256": "8c788e71aee2a63b62d3ab65c3cc15a1d1716fab307ad4cc4594b722fb52cb04"
  },
  {
   "id": "V04-num-frac",
   "kind": "canonical",
   "note": "定点小数最短往返",
   "input": {
    "a": 0.75,
    "b": -0.1,
    "c": 1.5
   },
   "expected_canonical": "{\"a\":0.75,\"b\":-0.1,\"c\":1.5}",
   "expected_sha256": "440841b9e384ed5ee4753545a1e8ebdfec4aba4dc8352f086a0fb342e85ff00a"
  },
  {
