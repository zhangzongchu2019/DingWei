    "b": 1,
    "a": 2,
    "A": 3
   },
   "expected_canonical": "{\"A\":3,\"a\":2,\"b\":1}",
   "expected_sha256": "e36823485c211bdf27aa7bb577fe79ba2ad122cfbb95023ae886736fd48e9b7c"
  },
  {
   "id": "V02-key-order-utf16",
