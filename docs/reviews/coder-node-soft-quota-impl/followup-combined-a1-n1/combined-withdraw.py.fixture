import pathlib,subprocess,json,hashlib
lab=pathlib.Path('/data/ai-dev-data/coder-soft-quota-lab');root=lab/'combined-withdrawal';pin='f3e6448d80089a5328d015f97280e0b8388630b6'
def source(p):return subprocess.check_output(['git','show',pin+':'+p],cwd=root).decode()
f='internal/nodeagent/softquota.go';s=source(f);cli='cmd/workpulse/hosted_admin.go';old=source(cli)
cases=[('inode-emergency',f,s.replace('if !unknown && q.space.FreeFiles < q.inodeEmergencyThreshold(q.space) {','if false && !unknown && q.space.FreeFiles < q.inodeEmergencyThreshold(q.space) {',1),'./internal/nodeagent','TestSoftInodeEmergencyBoundariesPersistStopAndRetainData'),('inode-independent-percent',f,s.replace('percent := q.policy.InodeEmergencyReservePercent','percent := uint64(q.policy.EmergencyReservePercent)',1),'./internal/nodeagent','TestSoftInodeEmergencyBoundariesPersistStopAndRetainData'),('n1-legacy-cli',cli,subprocess.check_output(['git','show','17115394397412d92be660df9c2cc2f1865c23a6:'+cli],cwd=root).decode(),'./cmd/workpulse','TestHostedAdminQuotaRegistrationCLIToNormalize'),('n1-revision',cli,old.replace('QuotaPolicyRevision: *quotaRevision','QuotaPolicyRevision: ""',1).replace('secret, err := st.RegisterNode','_ = quotaRevision\n\t\tsecret, err := st.RegisterNode',1),'./cmd/workpulse','TestHostedAdminQuotaRegistrationCLIToNormalize')]
results=[]
for name,path,mut,pkg,test in cases:
 original=source(path);assert mut!=original
 try:
  (root/path).write_text(mut);log='withdraw-combined-'+name+'.log';rc=subprocess.call(['python3',str(lab/'run-local.py'),log,'go','test',pkg,'-run','^'+test+'$','-v','-count=1','-timeout=120s'],cwd=root);raw=(lab/'evidence'/log).read_text();good=rc==1 and '--- FAIL: '+test in raw and '[build failed]' not in raw and 'test timed out' not in raw and 'panic:' not in raw
  results.append({'name':name,'file':path,'test':test,'rc':rc,'assertion_red':good,'original_sha256':hashlib.sha256(original.encode()).hexdigest(),'mutant_sha256':hashlib.sha256(mut.encode()).hexdigest()});print(name,good,flush=True)
 finally:(root/path).write_text(original)
 (lab/'evidence/COMBINED-WITHDRAWALS.json').write_text(json.dumps({'code_pin':pin,'cases':results},indent=2)+'\n')
assert all(c['assertion_red'] for c in results)
