[program:socat-vs-proxy]
autorestart=true
autostart=true
command=socat TCP-LISTEN:19324,bind=127.0.0.1,fork,reuseaddr TCP:127.0.0.1:19325
priority=50
startsecs=1
stderr_logfile=/dev/stderr
stderr_logfile_maxbytes=0
stdout_logfile=/dev/stdout
stdout_logfile_maxbytes=0
stopsignal=TERM
stopwaitsecs=5
; t112-environment key_count=0 keys_sorted_sha256=e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855
environment=%(ENVIRONMENT_SOCAT_VS_PROXY)s

