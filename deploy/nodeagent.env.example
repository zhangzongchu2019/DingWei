# nodeagent 环境样例（G4 托管节点代理）——值全是占位，由 prodops 按现网填。
# 键名与必填性取自 cmd/nodeagent/main.go（c0a0720b；A2 对 nodeagent 面零变化）。
# 🔴 凭据值永不进板件／消息／日志；本文件只放键名与占位。

# ── 连接四件（Config.validate 必填，缺即拒起）──
NODEAGENT_HUB_URL=wss://<HUB_HOST>/api/node/connect   # 必须 wss://
NODEAGENT_NODE_ID=nd_<hex16>                          # 须先 hosted-admin register-node 登记
NODEAGENT_SECRET_FILE={{STATE_DIR}}/node.secret       # 权限 ≤600，宽于即拒读；一次性凭据落盘
NODEAGENT_LEDGER_FILE={{STATE_DIR}}/node-ledger.json  # 幂等台账（command_id 去重），600

# ── TLS ──
# 策略必填（自签阶段），代码不强制：pin 为空＝走系统 CA（失败形态是握手错，不是拒启）。
# 🔴 与 R-CERT-RENEW 耦合：换证必改。🔴 pin 为空时进程会读代理 env（见文末代理段）。
NODEAGENT_HUB_CERT_SHA256=

# ── Docker／资源（🔴 三个无默认必填，缺即 log.Fatal）──
NODEAGENT_DOCKER_SOCK=                                # 独立 dockerd 实例的 socket；🔴 绝不用 /var/run/docker.sock
NODEAGENT_CGROUP_PARENT=                              # 席位父切片，如 dingwei-hosted.slice
NODEAGENT_SEAT_PROXY=                                 # 席位出网 relay，如 http://<relay 内网 IP>:11080

# ── 有默认、可覆盖 ──
NODEAGENT_SEAT_ROOT=/data/dingwei-newplat/agents      # 默认即此；实验节点 /data/dingwei-node
NODEAGENT_IMAGE_REGISTRY=hub.local/dingwei            # 固定镜像仓库白名单
NODEAGENT_LABELS=                                     # 可选 CSV，如 site=tc,spec=8c16g,pool=p1

# ── 席位到 Hub 通路（R-SEAT-HUB-VIA-PROXY 案②，生产默认开）──
# 开（1/true/yes/on）：席位 NO_PROXY 不含 Hub 主机＋注 SH_PROXY＝NODEAGENT_SEAT_PROXY
# ⇒ 席位 WS 与入网 HTTP 全走 relay CONNECT（helper WS 只认 SH_PROXY）。
# 关（不设/其它）：旧行为逐字不变（Hub 主机入 NO_PROXY、WS 直连）——B12／本机 Hub 场景用。
NODEAGENT_SEAT_HUB_VIA_PROXY=1

# ── 席位 Codex 模型指定（R-SEAT-MODEL-NODEAGENT，业主方案 1：托管落实 gpt-6.1-sol）──
# 可空：空＝不注入（与旧版逐字相同）；非空校验 1–64 位 [A-Za-z0-9._-]，非法即拒启报键名。
# 与镜像侧 start.py 的 CODEX_MODEL 读取配套（写 config.toml 的 model）。
NODEAGENT_SEAT_CODEX_MODEL=gpt-6.1-sol

# ── 席位 helper 模式（R-V2-HOSTED-DRIVER-IMPL，版本 2 指标 2）──
# cli｜driver；未设＝cli（现行为逐字不变）。driver ⇒ 席位 SH_MODE=driver＋SH_EMIT_SESSION_EVENT=1
#（cli 模式不产结构事件、view 看不到 Agent 回复）。非法值拒启报键名。
# 🔴 与镜像配套：B1d 起 start.py 的 SH_MODE 才「环境未给才默认 cli」（B1c 是无条件写死）。
# 🔴 未换 B1d 前保持不设（＝cli）：B1c 配 driver 节点写死了 cli，开了也不会出事件。
# NODEAGENT_SEAT_MODE=driver

# ── 可选模型清单（包 B2；运维配置，prodops 按业主要求设）──
# CSV；逐项须 1–64 位 [A-Za-z0-9._-]（坏值拒启报键名）。随容量帧上报 ⇒ console 建席表单的
# 模型下拉数据源（在线节点并集）。空＝不支持按席自选（行为同旧版）。
NODEAGENT_SEAT_CODEX_MODELS=gpt-6.1-sol

# ── 本机镜像白名单（格式不对即拒启并报键名）──
# CSV；每项剥一个 sha256: 前缀后须 64 位小写裸 hex。值与板上 HOSTED-IMAGE-VERSIONS 同源
# （版本 2 镜像重建后取其新生产行；B12 派生镜像不登记生产行）。
NODEAGENT_LOCAL_IMAGES=

# ── 出网代理（分条件；unit 已显式中和进程级代理 env，一般无需动这里）──
# 席位容器的代理三键由节点代理自动注入，且 NO_PROXY 自动追加 Hub 精确 host
#（internal/nodeagent/seat.go:244-256；Python 的 NO_PROXY 不认网段，故追加精确主机名）。
# 进程自身：pin（NODEAGENT_HUB_CERT_SHA256）非空 ⇒ Transport 无 Proxy 字段，直连；
# pin 为空（系统 CA 模式，如换证期摘 pin）⇒ WSS 拨号与 export_seat 的 client 回落默认
# Transport ⇒ 会读 HTTP(S)_PROXY——该模式下若节点确有代理 env，须把 Hub 主机加进进程级
# NO_PROXY。deploy/nodeagent.service 已把代理六键置空中和（结构性断言，不依赖本文件）。

# ── S-NODE-SOFT-QUOTA: default hard, never automatic fallback ──
# This example is NOT a host/pilot approval. Keep hard until the owner approves
# soft risk, old host-root/socket holders, thresholds, network and recovery.
NODEAGENT_QUOTA_MODE=hard
# Soft requires these non-secret approval coordinates plus an approved Engine ID
# and canonical isolated data-root. Do not put keys or credential values here.
NODEAGENT_SOFT_APPROVAL_REF=
NODEAGENT_HOST_ROOT_TRUST_REF=
NODEAGENT_NETWORK_APPROVAL_REF=
NODEAGENT_ENGINE_ID=
NODEAGENT_ENGINE_ROOT=
# nodeagent --print-policy-revision reads only this configuration: no Engine,
# credential read or connection. Register this revision with QuotaMode=soft;
# administrator labels.allow_soft=true AND user allow_soft=true are also needed.
# Private quota state is LEDGER_FILE.soft-quota (+ .lock), OUTSIDE SEAT_ROOT.
# Its directory must be private, regular state/lock 0600, same OS owner.
NODEAGENT_SCAN_INTERVAL=30s
NODEAGENT_SCAN_BUDGET=5s
NODEAGENT_MAX_AGE=60s
NODEAGENT_RESERVE_INTERVAL=5s
NODEAGENT_STOP_TIMEOUT=10s
NODEAGENT_WARN_PERCENT=80
NODEAGENT_RECOVERY_PERCENT=75
# Stop at the seat plan's positive DiskMB (100%); holds NEVER auto-clear.
# Reserve max(bytes, total*percent), plus unallocated seat commitments/image peak.
NODEAGENT_RESERVE_BYTES=34359738368
NODEAGENT_RESERVE_PERCENT=10
NODEAGENT_RESERVE_INODES=65536
NODEAGENT_RESERVE_INODE_PERCENT=1
NODEAGENT_IMAGE_RESERVE_BYTES=8589934592
NODEAGENT_MAX_SEATS=4
NODEAGENT_RESERVE_CPU_MILLICORES=2000
NODEAGENT_RESERVE_MEMORY_BYTES=4294967296
# New containers: explicit CPU bandwidth, PIDs, bounded local logs. Login remains
# LogConfig=none (device codes must not reach Docker logs). /tmp stays 8MiB.
NODEAGENT_PIDS_LIMIT=512
NODEAGENT_LOGIN_PIDS_LIMIT=128
NODEAGENT_SHM_BYTES=67108864
NODEAGENT_LOG_MAX_SIZE_MB=10
NODEAGENT_LOG_MAX_FILES=3
# No firewall rules are installed by this binary/config. Independent daemon,
# 0700/EngineID/cgroups do NOT resist an actor controlling the host via old RW
# Docker sockets; existing host-network actors are NOT bridge-isolated.
# A reference string is a deployment prerequisite, not proof of actual isolation.
