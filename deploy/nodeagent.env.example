# nodeagent 环境样例（G4 托管节点代理）——值全是占位，由 prodops 按现网填。
# 键名与必填性取自 cmd/nodeagent/main.go（8feb731d 起含 NODEAGENT_LOCAL_IMAGES）。
# 🔴 凭据值永不进板件／消息／日志；本文件只放键名与占位。

# ── 连接四件（Config.validate 必填，缺即拒起）──
NODEAGENT_HUB_URL=wss://<HUB_HOST>/api/node/connect   # 必须 wss://
NODEAGENT_NODE_ID=nd_<hex16>                          # 须先 hosted-admin register-node 登记
NODEAGENT_SECRET_FILE={{STATE_DIR}}/node.secret       # 权限 ≤600，宽于即拒读；一次性凭据落盘
NODEAGENT_LEDGER_FILE={{STATE_DIR}}/node-ledger.json  # 幂等台账（command_id 去重），600

# ── TLS ──
NODEAGENT_HUB_CERT_SHA256=                            # 自签阶段必填（64 位 hex）；🔴 与 R-CERT-RENEW 耦合：换证必改

# ── Docker／资源（🔴 三个无默认必填，缺即 log.Fatal）──
NODEAGENT_DOCKER_SOCK=                                # 独立 dockerd 实例的 socket；🔴 绝不用 /var/run/docker.sock
NODEAGENT_CGROUP_PARENT=                              # 席位父切片，如 dingwei-hosted.slice
NODEAGENT_SEAT_PROXY=                                 # 席位出网 relay，如 http://<relay 内网 IP>:11080

# ── 有默认、可覆盖 ──
NODEAGENT_SEAT_ROOT=/data/dingwei-newplat/agents      # 默认即此；实验节点 /data/dingwei-node
NODEAGENT_IMAGE_REGISTRY=hub.local/dingwei            # 固定镜像仓库白名单
NODEAGENT_LABELS=                                     # 可选 CSV，如 site=tc,spec=8c16g,pool=p1

# ── 本机镜像白名单（格式不对即拒启并报键名）──
# CSV；每项剥一个 sha256: 前缀后须 64 位小写裸 hex。值与板上 HOSTED-IMAGE-VERSIONS 同源
# （版本 2 镜像重建后取其新生产行；B12 派生镜像不登记生产行）。
NODEAGENT_LOCAL_IMAGES=

# ── 出网代理纪律（板 28e87deb 同款）──
# 节点自身若有 HTTP(S)_PROXY，须把 Hub 主机加进 NO_PROXY，否则拨入 Hub 会绕代理失败。
# NO_PROXY=<既有值>,${HUB_HOST}
